# 캐릭터 공장 API 키
# 이 파일(.env)은 Git에서 제외된다. 값은 따옴표 없이 = 뒤에 붙여 넣는다.
# 공장은 실행할 때 저장소 루트의 .env를 읽는다. 셸에 같은 이름이 이미 있으면 셸 값이 우선한다.
# 빈 값은 설정하지 않은 것으로 본다. 키 값을 로그·기록·대화에 붙여 넣지 않는다.

# --- 시연 경로(기획 S3 → 특질 S7 → 프롬프트 S8)에 필요 ---

# OpenAI 공식 API. GPT-6.1 Sol·Terra가 맡는 단계: 기본 프로필 정리, 설정 충돌 검토,
# 이견 재검토, 상황 설계, 전수 검사. 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini API(AI Studio). Gemini 3.8 Flash·4 Argon이 맡는 단계: 성격 초안,
# 성격 확정·최종 말투·대표 대사, 오류 수정. 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- 선택: 해당 기능을 켤 때만 ---

# Anthropic API. 모델 구성표 밖 단계([providers.text]·[providers.judge])를 Claude로
# 직접 부를 때만 쓴다. 공식 API 연결에서 이 단계들을 GPT·Gemini로 옮기면 필요 없다.
ANTHROPIC_API_KEY=

# xAI 영상 API 키. 영상(S5·S6)의 2순위 경로다. 1순위는 공장 Grok 로그인(cfp grok login)이며
# (D-0183·D-0184), 로그인이 없거나 갱신할 수 없거나 거절되면 이 키를 쓴다. 유료.
# 공장 Grok 로그인 파일 위치를 바꿀 때만: CFP_XAI_OAUTH_FILE=
XAI_API_KEY=

# TypeSafe(console.typesafe.ai). 대화해 보기에서 답마다 반응 영상을 jev(jev-latest)로 고른다(api-svc와 같은 방식).
# 비워 두면 Gemini 3.5 Flash(GEMINI_API_KEY)로 고른다. 키를 넣으면 서버를 다시 켜지 않아도 다음 대화부터 쓴다.
TYPESAFE_API_KEY=

# 앱 내보내기 적재 확인용 일회용 로컬 DB 주소. 외부 키가 아니다.
# scripts/verify_db.sh up 이 출력하는 값을 넣는다.
CFP_PG_ADMIN_URL=

# 참고: GPU 학습(Vast.ai) 키는 여기가 아니라 vastai 프로그램 설정에 이미 저장돼 있다.
# 공식 이미지 생성·참조 사진 편집도 위 OPENAI_API_KEY를 사용한다.
# 구독 경로 codex_image는 명시적으로 고를 때만 ChatGPT 로그인을 사용한다.


# --- 선택: 시연 모드 알림·테스터 전용 미리보기 발행 ---

# 디스코드 웹후크. 시연 모드가 발행·멈춤·예산 상한을 알린다. 비우면 알리지 않는다.
CFP_DISCORD_WEBHOOK_URL=
# 알림에 붙일 공장 화면 주소(예: https://factory.example.com). 비우면 링크 없이 보낸다.
CFP_STUDIO_PUBLIC_URL=

# 테스터 전용 미리보기 발행([publish.preview], D-0206). dev 넣기 서비스 토큰(X-Factory-Import-Token).
# 값은 deployments 저장소 dev Environment 의 FACTORY_IMPORT_TOKEN 과 같다. 로그·대화에 붙여 넣지 않는다.
FACTORY_IMPORT_TOKEN=
# 넣기 서비스 주소. factory.toml [publish.preview] base_url 이 있으면 그쪽이 먼저다.
FACTORY_IMPORT_BASE_URL=https://factory-import.dev.dokilabs.com

