      },
      {
        "id": "eval_input_mismatch",
        "signal": "train and eval system differ",
        "causeLocation": "eval",
        "firstIntervention": "align eval system to training canon text"
      },
      {
        "id": "user_fact_fabrication",
        "signal": "states user facts, shared past or agreement without evidence",
        "causeLocation": "data",
        "firstIntervention": "check canon fact rule, then add ownership/history scenes"
      },
      {
        "id": "false_promise_acceptance",
        "signal": "accepts pleasant false promise",
        "causeLocation": "data",
        "firstIntervention": "history scenes correcting pleasant false premises"
      },
      {
        "id": "owner_confusion",
        "signal": "user or third-party fact spoken as own",
        "causeLocation": "data",
        "firstIntervention": "ownership owner-separation decoy scenes"
      },
      {
        "id": "self_schedule_drift",
        "signal": "own schedule changes or disappears later",
        "causeLocation": "data",
        "firstIntervention": "ownership + long scenes recalling own schedule after topic shifts"
      },
      {
        "id": "overbroad_fact_rule",
        "signal": "refuses to create own schedule or taste",
        "causeLocation": "prompt",
        "firstIntervention": "narrow canon fact rule to user facts, shared past, agreements; log policy change"
      },
      {
        "id": "refused_fact_hedging",
        "signal": "answers 'not sure' about something it refused",
        "causeLocation": "data",
        "firstIntervention": "history scenes; do not tune epochs if all checkpoints fail"
      },
      {
        "id": "perfunctory_apology_acceptance",
        "signal": "accepts perfunctory apology after long context",
        "causeLocation": "data",
        "firstIntervention": "long-cluster late trigger with perfunctory apology"
      },
      {
        "id": "emotion_subject_flip",
        "signal": "asks 'still angry?' when the user is silent",
        "causeLocation": "data",
        "firstIntervention": "conflict scenes where character keeps own feeling through silence"
      },
      {
        "id": "unwarranted_co_apology",
        "signal": "apologizes together when user is at fault",
        "causeLocation": "data",
        "firstIntervention": "fix existing conflict dialogues containing co-apology"
      },
      {
        "id": "relationship_threat",
        "signal": "threat or cutoff after continued rudeness",
        "causeLocation": "data",
        "firstIntervention": "conflict scenes with calm distancing, no threat"
      },
      {
        "id": "hurt_unexpressed",
        "signal": "only asks back, never states hurt with reason",
        "causeLocation": "data",
        "firstIntervention": "conflict real-hurt type scenes"
      },
      {
        "id": "register_break",
        "signal": "register or channel notation breaks",
        "causeLocation": "prompt",
        "firstIntervention": "relationship/channel sentence A/B on same weights, then data"
      },
      {
        "id": "habit_decoration",
        "signal": "habit repeated without position",
        "causeLocation": "data",
        "firstIntervention": "rulebook positions + renderer frequency caps"
      },
      {
        "id": "long_recap_repetition",
        "signal": "re-confirms agreed plan every turn late in long chat",
        "causeLocation": "data",
        "firstIntervention": "turn mix + recap metrics, fix the offending bundle"
      },
      {
