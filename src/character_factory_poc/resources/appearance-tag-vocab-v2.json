  "clusterBasis": {
    "note": "외모군은 두 모델 일치율이 minAgreement 이상인 얼굴 구조 칸과 분위기(vibe)로 나눈다. 스타일링 칸·피부톤·눈매(eyeShape)는 기준에서 뺀다.",
    "minAgreement": 0.6,
    "vibeWeight": 2,
    "exclude": [
      "eyeShape",
      "hairLength",
      "hairColor",
      "hairStyle",
      "bangs",
      "makeup",
      "skinTone",
      "ageImpression"
    ]
  },
